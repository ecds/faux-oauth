<h1>Sign up</h1>

<% if @user.errors.any? %>
  <div class="errors">
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: register_path(origin: @origin), method: :post do |f| %>
  <div class="field">
    <%= f.text_field :name, placeholder: " " %>
    <%= f.label :name %>
  </div>
  <div class="field">
    <%= f.email_field :email, required: true, placeholder: " " %>
    <%= f.label :email %>
  </div>
  <div class="field">
    <%= f.password_field :password, required: true, placeholder: " " %>
    <%= f.label :password %>
  </div>
  <div class="field">
    <%= f.password_field :password_confirmation, required: true, placeholder: " " %>
    <%= f.label :password_confirmation, "Confirm password" %>
  </div>
  <%= f.submit "Sign up", class: "btn btn-primary" %>
<% end %>

<p class="helper">Already have an account? <%= link_to "Log in", login_path(origin: @origin) %></p>

<%= render "shared/provider_buttons", origin: @origin %>

<h1>Log in</h1>

<% if @error %>
  <div class="errors"><%= @error %></div>
<% end %>

<%= form_with url: login_path(origin: @origin), method: :post do |f| %>
  <div class="field">
    <%= f.email_field :email, required: true, placeholder: " " %>
    <%= f.label :email %>
  </div>
  <div class="field">
    <%= f.password_field :password, required: true, placeholder: " " %>
    <%= f.label :password %>
  </div>
  <%= f.submit "Log in", class: "btn btn-primary" %>
<% end %>

<p class="helper">
  <%= link_to "Create an account", register_path(origin: @origin) %>
  &nbsp;&middot;&nbsp;
  <%= link_to "Forgot your password?", new_password_path(origin: @origin) %>
</p>

<%= render "shared/provider_buttons", origin: @origin %>

<!DOCTYPE html>
<html>
  <head>
    <title>Faux OAuth</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-param" content="<%= request_forgery_protection_token %>">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <style>
      :root {
        --blue: #1a73e8;
        --blue-dark: #1558b0;
        --border: #dcdfe4;
        --text: #1a1a1a;
        --muted: #6b7280;
        --bg: #ffffff;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--text);
        background: var(--bg);
      }

      .auth-container {
        max-width: 400px;
        margin: 0 auto;
        padding: 56px 24px 40px;
      }

      h1 {
        text-align: center;
        font-size: 30px;
        font-weight: 800;
        margin: 0 0 32px;
      }

      .field {
        position: relative;
        margin-bottom: 18px;
      }

      .field input {
        width: 100%;
        padding: 16px 14px;
        font-size: 16px;
        font-family: inherit;
        color: var(--text);
        border: 1.5px solid var(--border);
        border-radius: 12px;
        outline: none;
        transition: border-color 0.15s ease;
      }

      .field input:focus {
        border-color: var(--blue);
      }

      .field label {
        position: absolute;
        left: 12px;
        top: 16px;
        padding: 0 4px;
        background: var(--bg);
        color: var(--muted);
        font-size: 16px;
        pointer-events: none;
        transition: all 0.12s ease;
      }

      .field input:focus + label,
      .field input:not(:placeholder-shown) + label {
        top: -9px;
        font-size: 12.5px;
        color: var(--blue);
      }

      .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 15px;
        font-size: 16px;
        font-family: inherit;
        font-weight: 700;
        border-radius: 12px;
        cursor: pointer;
        text-decoration: none;
        box-sizing: border-box;
      }

      .btn-primary {
        background: var(--blue);
        color: #fff;
        border: none;
        margin-top: 6px;
      }

      .btn-primary:hover { background: var(--blue-dark); }

      .btn-outline {
        background: #fff;
        color: var(--text);
        border: 1.5px solid var(--border);
        font-weight: 600;
        font-size: 15px;
        margin-bottom: 12px;
      }

      .btn-outline:hover { background: #f7f8f9; }

      .helper {
        text-align: center;
        color: var(--muted);
        font-size: 14.5px;
        margin: 20px 0 0;
      }

      .helper a { color: var(--blue); text-decoration: none; font-weight: 600; }
      .helper a:hover { text-decoration: underline; }

      .divider {
        display: flex;
        align-items: center;
        gap: 14px;
        color: #9aa0a6;
        font-size: 14px;
        margin: 28px 0 20px;
      }

      .divider::before, .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      .message {
        text-align: center;
        color: var(--muted);
        font-size: 15.5px;
        line-height: 1.5;
        margin-bottom: 24px;
      }

      .errors {
        background: #fdecea;
        border: 1px solid #f5c2c0;
        color: #8b2b26;
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14.5px;
      }

      .errors ul { margin: 0; padding-left: 18px; }
    </style>
  </head>
  <body>
    <div class="auth-container">
      <%= yield %>
    </div>
  </body>
</html>
